GOVERNADA_GITHUB_CLIENT_ID_OP_REF=op://Governada-Agent/governada-agent-app/client_id
GOVERNADA_GITHUB_INSTALLATION_ID_OP_REF=op://Governada-Agent/governada-agent-app/installation_id
GOVERNADA_GITHUB_APP_PRIVATE_KEY_OP_REF=op://Governada-Agent/governada-agent-app/private_key
GOVERNADA_GITHUB_APP_PRIVATE_KEY_ROTATE_AFTER=2027-05-05

# Preprod app/runtime refs for local agent work. Values stay in 1Password.
ANTHROPIC_API_KEY_OP_REF=op://Governada-Agent/governada-preprod-environment/ANTHROPIC_API_KEY
NEXT_PUBLIC_SUPABASE_URL_OP_REF=op://Governada-Agent/governada-sandbox-environment/NEXT_PUBLIC_SUPABASE_URL
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY_OP_REF=op://Governada-Agent/governada-sandbox-environment/NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
SUPABASE_SECRET_KEY_OP_REF=op://Governada-Agent/governada-sandbox-environment/SUPABASE_SECRET_KEY
# Client analytics key — the dev/staging PostHog project token, matching the
# preview workflow's NEXT_PUBLIC_POSTHOG_KEY=POSTHOG_DEV_PROJECT_TOKEN wiring.
NEXT_PUBLIC_POSTHOG_KEY_OP_REF=op://Governada-Agent/governada-posthog-staging/POSTHOG_DEV_PROJECT_TOKEN
NEXT_PUBLIC_POSTHOG_HOST_OP_REF=op://Governada-Agent/governada-preprod-environment/NEXT_PUBLIC_POSTHOG_HOST
NEXT_PUBLIC_SITE_URL_OP_REF=op://Governada-Agent/governada-preprod-environment/NEXT_PUBLIC_SITE_URL
CRON_SECRET_OP_REF=op://Governada-Agent/governada-preprod-environment/CRON_SECRET
SESSION_SECRET_OP_REF=op://Governada-Agent/governada-preprod-environment/SESSION_SECRET
UPSTASH_REDIS_REST_URL_OP_REF=op://Governada-Agent/governada-preprod-environment/UPSTASH_REDIS_REST_URL
UPSTASH_REDIS_REST_TOKEN_OP_REF=op://Governada-Agent/governada-preprod-environment/UPSTASH_REDIS_REST_TOKEN

# Local dev flags — non-secret literals, injected verbatim by env:run.
# DEV_MOCK_AUTH enables /api/auth/dev-mock for testing auth-gated flows locally.
DEV_MOCK_AUTH=true

# Supabase automation refs for non-production schema/typegen and preview support.
SUPABASE_ACCESS_TOKEN_OP_REF=op://Governada-Agent/governada-supabase-automation/SUPABASE_ACCESS_TOKEN
SUPABASE_PREVIEW_ACCESS_TOKEN_OP_REF=op://Governada-Agent/governada-supabase-automation/SUPABASE_PREVIEW_ACCESS_TOKEN
SUPABASE_PREVIEW_PARENT_PROJECT_REF_OP_REF=op://Governada-Agent/governada-supabase-automation/SUPABASE_PREVIEW_PARENT_PROJECT_REF
SUPABASE_SANDBOX_PROJECT_REF_OP_REF=op://Governada-Agent/governada-supabase-automation/SUPABASE_SANDBOX_PROJECT_REF

# PostHog staging refs for telemetry checks and preview wiring.
POSTHOG_PERSONAL_API_KEY_OP_REF=op://Governada-Agent/governada-posthog-staging/POSTHOG_PERSONAL_API_KEY
POSTHOG_PROJECT_ID_OP_REF=op://Governada-Agent/governada-posthog-staging/POSTHOG_PROJECT_ID
POSTHOG_DEV_PROJECT_TOKEN_OP_REF=op://Governada-Agent/governada-posthog-staging/POSTHOG_DEV_PROJECT_TOKEN

# Observability automation refs for local/CI agent wrappers.
BETTERSTACK_API_TOKEN_OP_REF=op://Governada-Agent/governada-betterstack-automation/token
SENTRY_AUTH_TOKEN_OP_REF=op://Governada-Agent/governada-sentry-automation/token
