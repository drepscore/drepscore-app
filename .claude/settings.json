{
  "respectGitignore": true,
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "Agent",
      "Skill",
      "TodoWrite",
      "NotebookEdit",
      "mcp__linear__*",
      "mcp__supabase__*",
      "mcp__supabase-staging__*",
      "mcp__supabase-account__list_organizations",
      "mcp__supabase-account__get_organization",
      "mcp__supabase-account__list_projects",
      "mcp__supabase-account__get_project",
      "mcp__supabase-account__get_cost",
      "mcp__supabase-account__list_branches",
      "mcp__supabase-account__get_logs",
      "mcp__supabase-account__get_advisors",
      "mcp__supabase-account__search_docs",
      "mcp__sentry__*",
      "mcp__github__*",
      "mcp__railway__*",
      "mcp__Claude_Preview__*",
      "mcp__Claude_in_Chrome__*",
      "mcp__scheduled-tasks__*",
      "Bash(npm run git:push:*)",
      "Bash(bin/gh.sh api --method DELETE:*)"
    ],
    "deny": [
      "mcp__supabase-account__create_project",
      "mcp__supabase-account__pause_project",
      "mcp__supabase-account__restore_project",
      "mcp__supabase-account__confirm_cost",
      "mcp__supabase-account__create_branch",
      "mcp__supabase-account__delete_branch",
      "mcp__supabase-account__merge_branch",
      "mcp__supabase-account__reset_branch",
      "mcp__supabase-account__rebase_branch"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/report-gh-auth.sh"
          },
          {
            "type": "command",
            "command": "node scripts/check-checkout-freshness.mjs --mode session-start"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/pre-done.sh --hook-mode"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/check-branch.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/check-gh-lane.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/check-behind-main.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/plan-required.sh --hook-mode"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/brain-freshness-at-pr.sh --hook-mode"
          }
        ]
      },
      {
        "matcher": "mcp__supabase__apply_migration",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/migration-pr-binding.sh"
          }
        ]
      },
      {
        "matcher": "mcp__supabase-staging__apply_migration",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/migration-pr-binding.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/check-force-dynamic.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/check-inngest-registration.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/doc-creation-warn.sh --hook-mode"
          }
        ]
      },
      {
        "matcher": "Compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/post-compact.sh"
          }
        ]
      }
    ]
  }
}
